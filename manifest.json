{
  "manifest_version": 3,
  "name": "Croma Live Stock Checker",
  "version": "1.0.0",
  "description": "Opens a real Croma tab, checks product/cart availability and sends Telegram alerts.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://www.croma.com/*",
    "https://api.telegram.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.croma.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Croma Stock Checker"
  }
}